{
  "$schema": "https://gitee.com/dotnetchina/Furion/raw/v4/schemas/v4/furion-schema.json",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionConfigs": [
    {
      // 【安全】数据库密码不得提交到仓库，下方连接串中 Password 仅为占位。覆盖方式：
      //  在输出目录放置 secrets.json（容器部署挂载到 /app/secrets.json，模板见仓库根目录
      //  secrets.json.example），其中 ConnectionConfigs:0:ConnectionString 后加载覆盖此处占位。
      //  注意：经实测 Furion 捕获的 App.Configuration 不含进程环境变量，环境变量方式不可用（见 DEPLOY.md）。
      "ConnectionString": "Data Source=192.168.68.131;Database=LogicNet;User ID=root;Password=CHANGE_ME;pooling=true;port=3306;sslmode=none;CharSet=utf8;SslMode=Required",
      "DbType": "MySql",
      "IsAutoCloseConnection": true
    }
  ]
}