{
  "//": "机密配置模板。复制为 secrets.json 并填入真实值（secrets.json 已被 .gitignore 排除，切勿提交）。容器部署时挂载到 /app/secrets.json，宿主上属主须为 uid 1654、权限 600（步骤见 DEPLOY.md）。",
  "JWTSettings": {
    "//": "必填，≥16 字符。生成方式：openssl rand -base64 48",
    "IssuerSigningKey": "CHANGE_ME"
  },
  "ConnectionConfigs": [
    {
      "//": "方案 A（默认）指向已有 MySQL 实例；方案 B（compose 内置 MySQL）把 Data Source 改为 mysql、库名 logicnet、密码与 .env 的 DB_ROOT_PASSWORD 一致",
      "ConnectionString": "Data Source=192.168.x.x;Database=LogicNet;User ID=logicnet;Password=CHANGE_ME;pooling=true;port=3306;CharSet=utf8mb4;SslMode=none",
      "DbType": "MySql",
      "IsAutoCloseConnection": true
    }
  ]
}
