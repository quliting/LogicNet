<Project Sdk="Microsoft.NET.Sdk">


	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<NoWarn>1701;1702;1591</NoWarn>
		<DocumentationFile>LogicNet.Application.xml</DocumentationFile>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="applicationsettings.json" />
		<None Remove="LogicNet.Application.xml" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="applicationsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\LogicNet.Core\LogicNet.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Dll\" />
		<Folder Include="UserInfo\Services\" />
	</ItemGroup>

	<!--
	    Aspose.Words.dll 为本地未跟踪文件（许可证/体积原因不入库）。
	    dll 存在（本地开发）→ 正常引用并编译 TestService；dll 缺失（CI/干净检出）→ 跳过引用并排除 TestService.cs，
	    保证流水线可构建。TestService 仅演示 Word 替换，不影响业务接口。
	-->
	<ItemGroup Condition="Exists('Dll\Aspose.Words.dll')">
	  <Reference Include="Aspose.Words">
	    <HintPath>Dll\Aspose.Words.dll</HintPath>
	  </Reference>
	</ItemGroup>
	<ItemGroup Condition="!Exists('Dll\Aspose.Words.dll')">
	  <Compile Remove="Test\Service\TestService.cs" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Update="Microsoft.SourceLink.GitHub" Version="10.0.403">
	    <PrivateAssets>all</PrivateAssets>
	    <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	  </PackageReference>
	</ItemGroup>

</Project>
