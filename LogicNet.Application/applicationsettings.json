{
  "$schema": "https://gitee.com/dotnetchina/Furion/raw/v4/schemas/v4/furion-schema.json",
  "SpecificationDocumentSettings": {
    "DocumentTitle": "Logic Swagger",
    "GroupOpenApiInfos": [
      {
        "Group": "Default",
        "Title": "规范化接口演示",
        "Description": "让 .NET 开发更简单，更通用，更流行。",
        "Version": "1.0.0",
        "TermsOfService": "https://furion.net",
        "Contact": {
          "Name": "百小僧",
          "Url": "https://gitee.com/monksoul",
          "Email": "monksoul@outlook.com"
        },
        "License": {
          "Name": "Apache-2.0",
          "Url": "https://gitee.com/dotnetchina/Furion/blob/rc1/LICENSE"
        }
      }
    ]
  },
  "CorsAccessorSettings": {
    "WithExposedHeaders": [
      "access-token",
      "x-access-token",
      "environment"
    ]
  },
  //项目的配置信息
  "AppSettings": {
    "Host": "https://localhost:5001/",
    "DeleteDirectory": "Temp"
  },
  //JWT的配置
  //【安全】IssuerSigningKey 严禁提交真实密钥到仓库。注意：经实测（见 DEPLOY.md），Furion 在 Serve.Run 宿主下
  // 捕获的 App.Configuration 不包含进程环境变量，因此请通过 json 文件配置（任选其一）：
  //  1. 容器部署：挂载 secrets.json 到 /app/secrets.json（模板见仓库根目录 secrets.json.example，Furion 自动扫描加载）
  //  2. 本地开发：在输出目录同级的 LogicNet.Application/applicationsettings.json 旁放置 secrets.json（已 gitignore）
  //  3. 生成强随机密钥：openssl rand -base64 48
  // 本文件故意不保留 IssuerSigningKey 空占位，避免空值覆盖 secrets.json 中的真实密钥（后加载源覆盖先加载源）。
  // 未配置或长度不足 16 字符时应用启动将直接失败（fail-fast，见 LogicNet.Web.Core/Startup.cs）。
  "JWTSettings": {
    "ValidateIssuerSigningKey": true,
    "ValidateIssuer": false,
    "ValidIssuer": "qlt",
    "ValidateAudience": false,
    "ValidAudience": "qlt",
    "ValidateLifetime": true,
    "ExpiredTime": 99,
    "ClockSkew": 1,
    "Algorithm": "HS256",
    "ModelToQuery": true
  },
  "DynamicApiControllerSettings": {
    "DefaultRoutePrefix": "Api",
    "KeepName": true,
    "UrlParameterization": true,
    "KeepVerb": true,
    "SupportedMvcController": true,
    "LowercaseRoute": false,
    "ModelToQuery": true
  },
  // 验证码配置
  "CaptchaOptions": {
    "CaptchaType": 5,
    // 验证码类型
    "CodeLength": 4,
    // 验证码长度, 要放在CaptchaType设置后  当类型为算术表达式时，长度代表操作的个数, 例如2
    "ExpirySeconds": 120,
    // 验证码过期秒数
    "IgnoreCase": true,
    // 比较时是否忽略大小写
    "StoreageKeyPrefix": "",
    // 存储键前缀
    "ImageOption": {
      "Animation": false,
      // 是否启用动画
      "FontSize": 32,
      // 字体大小
      "Width": 100,
      // 验证码宽度
      "Height": 40,
      // 验证码高度
      "BubbleMinRadius": 5,
      // 气泡最小半径
      "BubbleMaxRadius": 10,
      // 气泡最大半径
      "BubbleCount": 3,
      // 气泡数量
      "BubbleThickness": 1.0,
      // 气泡边沿厚度
      "InterferenceLineCount": 3,
      // 干扰线数量
      "FontFamily": "kaiti",
      // 包含actionj,epilog,fresnel,headache,lexo,prefix,progbot,ransom,robot,scandal,kaiti
      "FrameDelay": 15,
      // 每帧延迟,Animation=true时有效, 默认30
      "BackgroundColor": "#ffffff",
      //  格式: rgb, rgba, rrggbb, or rrggbbaa format to match web syntax, 默认#fff
      "ForegroundColors": "",
      //  颜色格式同BackgroundColor,多个颜色逗号分割，随机选取。不填，空值，则使用默认颜色集
      "Quality": 100,
      // 图片质量（质量越高图片越大，gif调整无效可能会更大）
      "TextBold": false
      // 粗体，该配置2.0.3新增
    }
  }
}