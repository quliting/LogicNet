# LogicNet 部署配置模板。复制为 .env 后填写真实值：cp .env.example .env
# .env 已被 .gitignore 排除，只存在于部署机本地，切勿提交。

# 应用对外暴露的宿主端口（容器内固定 8080）
APP_PORT=8080

# JWT 签名密钥（必填，≥16 字符，建议 48 字节随机）
# 生成方式：openssl rand -base64 48
JWT_ISSUER_SIGNING_KEY=

# 数据库连接串（必填，覆盖 appsettings.json 占位）
# 方案 A（默认，复用外部 MySQL）：把主机/账号/密码改为已有实例，例如：
#   Data Source=192.168.2.100;Database=LogicNet;User ID=logicnet;Password=改为真实密码;pooling=true;port=3306;CharSet=utf8mb4;SslMode=none
# 方案 B（compose 内置 MySQL）：先按 docker-compose.yml 文件头注释启用 mysql 服务，再填：
#   Data Source=mysql;Database=logicnet;User ID=root;Password=<与下方 DB_ROOT_PASSWORD 一致>;pooling=true;port=3306;CharSet=utf8mb4;SslMode=none
# 说明：历史连接串中 SslMode 取值不一致（none 与 Required 并存）的问题留待确认，
#       内网部署暂按 SslMode=none；如需强制 TLS 请确认 MySQL 已配置证书后改为 Required。
DB_CONNECTION_STRING=

# 仅方案 B 使用：内置 MySQL 的 root 密码
# 生成方式：openssl rand -base64 32
DB_ROOT_PASSWORD=
