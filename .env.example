# LogicNet 部署 compose 插值模板。复制为 .env：cp .env.example .env
# .env 已被 .gitignore 排除，只存在于部署机本地，切勿提交。
# 注意：JWT 密钥与数据库连接串不在本文件，而在 secrets.json（模板见 secrets.json.example，
#       Furion 经文件扫描加载配置，不读取进程环境变量，详见 DEPLOY.md）。

# 应用对外暴露的宿主端口（容器内固定 8080）
APP_PORT=8080

# 仅方案 B（compose 内置 MySQL）使用：内置 MySQL 的 root 密码，
# 须与 secrets.json 连接串中的 Password 一致。生成方式：openssl rand -base64 32
DB_ROOT_PASSWORD=
